{% extends "base.html" %}
{% block content %}
<header class="top"><h1>{{ 'Araç Düzenle' if car else 'Yeni Araç Ekle' }}</h1></header>
<form class="form" method="post" enctype="multipart/form-data">
  <label>Marka<input name="brand" value="{{ car.brand if car else '' }}" required placeholder="Renault"></label>
  <label>Model<input name="model" value="{{ car.model if car else '' }}" required placeholder="Clio"></label>
  <label>Yıl<input type="number" name="year" value="{{ car.year if car else '' }}" placeholder="2020"></label>
  <label>Plaka<input name="plate" value="{{ car.plate if car else '' }}" placeholder="11 ABC 111"></label>
  <label>Günlük Fiyat<input type="number" step="0.01" name="daily_price" value="{{ car.daily_price if car else '' }}" required placeholder="1500"></label>
  <label>Durum<select name="status"><option {% if car and car.status=='Müsait' %}selected{% endif %}>Müsait</option><option {% if car and car.status=='Kirada' %}selected{% endif %}>Kirada</option><option {% if car and car.status=='Bakımda' %}selected{% endif %}>Bakımda</option></select></label>
  <label>Fotoğraf<input type="file" name="image" accept="image/png,image/jpeg,image/webp"></label>
  <label class="full">Not<textarea name="notes" placeholder="Araç açıklaması, yakıt, vites vb.">{{ car.notes if car else '' }}</textarea></label>
  <button class="btn" type="submit">Kaydet</button>
</form>
{% endblock %}
