{% extends "base.html" %}{% block content %}<section class="hero"><h1>Rent A Car Yönetim Paneli</h1><p>Araç ekle, fotoğraf yükle, günlük fiyat belirle ve kiralama durumunu takip et.</p></section><div class="stats"><div><b>{{total}}</b><span>Toplam Araç</span></div><div><b>{{available}}</b><span>Müsait</span></div><div><b>{{rented}}</b><span>Kirada</span></div></div><div class="grid">{% for car in cars %}<div class="card">{% if car.image %}<img src="{{ url_for('static', filename='uploads/' ~ car.image) }}">{% else %}<div class="noimg">Fotoğraf Yok</div>{% endif %}<div class="pad"><h3>{{car.brand}} {{car.model}}</h3><p>{{car.plate or '-'}} • {{car.year or '-'}}</p><div class="price">{{'%.0f'|format(car.daily_price)}} TL / Gün</div><span class="badge">{{car.status}}</span><div class="actions"><a href="{{ url_for('edit_car', car_id=car.id) }}">Düzenle</a><form method="post" action="{{ url_for('delete_car', car_id=car.id) }}" onsubmit="return confirm('Silinsin mi?')"><button>Sil</button></form></div></div></div>{% else %}<p>Henüz araç yok. Araç ekle butonuna bas.</p>{% endfor %}</div>{% endblock %}
